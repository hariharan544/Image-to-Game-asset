# Copy to .env (never commit .env). Forge reads it automatically.

# Tripo API key from https://platform.tripo3d.ai  (starts with tsk_)
TRIPO_API_KEY=tsk_your_key_here

# Optional: full path to blender.exe if it is not in the default install folder
# FORGE_BLENDER=C:\Program Files\Blender Foundation\Blender 5.0\blender.exe

# AI supervisor (local open model served by Ollama / LM Studio / llama.cpp)
FORGE_LLM_URL=http://localhost:11434/v1
FORGE_LLM_MODEL=forge-supervisor
# Vision model for the final visual critique (optional)
# FORGE_VLM_MODEL=qwen2.5vl:7b
